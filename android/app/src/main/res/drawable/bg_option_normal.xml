<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel2" />
            <stroke android:width="1.5dp" android:color="@color/cyan" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/d_card" />
            <stroke android:width="1dp" android:color="@color/d_line" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
