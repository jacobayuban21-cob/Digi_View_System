<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account &amp; Cloud Sync"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure your deployed server and student profile."
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- ================= SERVER URL SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVER BASE URL"
            android:textColor="@color/cyan_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_option_normal"
            android:hint="https://digi-view-system.onrender.com/"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="textUri" />

        <!-- Server Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetRender"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#162B4A"
                android:text="☁️ Render Cloud"
                android:textColor="@color/cyan"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetLocal"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#162B4A"
                android:text="💻 Emulator Local"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Live Connection Test -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestConnection"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/blue"
                android:text="⚡ Test Server"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ready to test"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/d_line"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- ================= STUDENT PROFILE SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STUDENT DETAILS"
            android:textColor="@color/cyan_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <!-- Full Name input -->
        <EditText
            android:id="@+id/etAuthFullName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_option_normal"
            android:hint="Full Name (e.g. Juan Dela Cruz)"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="textPersonName" />

        <!-- Grade & Section input -->
        <EditText
            android:id="@+id/etAuthSection"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_option_normal"
            android:hint="Grade &amp; Section (e.g. Grade 11 - STEM A)"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="10dp"
            android:inputType="text" />

        <!-- Username input -->
        <EditText
            android:id="@+id/etAuthUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_option_normal"
            android:hint="Username"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="10dp"
            android:inputType="textNoSuggestions" />

        <!-- Action: Save / Switch User -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue"
            android:text="Save &amp; Connect Profile"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            android:layout_marginTop="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthCancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Cancel"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
