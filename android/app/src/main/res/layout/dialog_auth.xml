<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account &amp; Sync"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect your desktop or cloud profile."
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp" />

        <!-- Full Name input -->
        <EditText
            android:id="@+id/etAuthFullName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_option_normal"
            android:hint="Full Name (e.g. Juan Dela Cruz)"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="textPersonName" />

        <!-- Grade & Section input -->
        <EditText
            android:id="@+id/etAuthSection"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_option_normal"
            android:hint="Grade &amp; Section (e.g. Grade 11 - STEM A)"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="10dp"
            android:inputType="text" />

        <!-- Username input -->
        <EditText
            android:id="@+id/etAuthUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_option_normal"
            android:hint="Username"
            android:textColorHint="@color/muted"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="10dp"
            android:inputType="textNoSuggestions" />

        <!-- Action: Save / Switch User -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue"
            android:text="Save &amp; Sync Profile"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            android:layout_marginTop="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthCancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Cancel"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
