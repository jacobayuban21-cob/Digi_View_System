<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- ================= TOP APP BAR ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/d_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Brand Logo + Name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_dv_logo"
                android:gravity="center"
                android:text="DV"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIGIVIEW"
                android:textColor="@color/cyan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Live XP Pill -->
        <LinearLayout
            android:id="@+id/topXpPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvTopXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 0 XP"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Level Pill -->
        <LinearLayout
            android:id="@+id/topLevelPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvTopLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level 1"
                android:textColor="@color/cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cloud Server Status Pill (Hidden for release: automatic server sync) -->
        <LinearLayout
            android:id="@+id/topCloudPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTopCloud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☁️"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- User Initials Avatar Badge -->
        <TextView
            android:id="@+id/topAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/cyan_glow"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/d_line"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= DYNAMIC CONTENT CONTAINER ================= -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= BOTTOM NAVIGATION BAR (6 DESKTOP SECTIONS) ================= -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/d_line"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:background="@color/d_sidebar"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Dashboard -->
        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/labelNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/cyan"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 2. Lessons -->
        <LinearLayout
            android:id="@+id/navLessons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconNavLessons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/labelNavLessons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lessons"
                android:textColor="@color/muted"
                android:textSize="10.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 3. Quiz -->
        <LinearLayout
            android:id="@+id/navQuiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconNavQuiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/labelNavQuiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quiz"
                android:textColor="@color/muted"
                android:textSize="10.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 4. Achievements -->
        <LinearLayout
            android:id="@+id/navAchievements"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconNavAchievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/labelNavAchievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Badges"
                android:textColor="@color/muted"
                android:textSize="10.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 5. History -->
        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconNavHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/labelNavHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="@color/muted"
                android:textSize="10.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 6. Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/labelNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/muted"
                android:textSize="10.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= FULLSCREEN AUTH OVERLAY (LOGIN & SIGN UP GREETING) ================= -->
    <FrameLayout
        android:id="@+id/authScreenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/layout_auth" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
