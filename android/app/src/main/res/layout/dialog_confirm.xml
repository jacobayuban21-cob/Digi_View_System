<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="380dp"
    android:background="@drawable/bg_auth_card"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="28dp"
    android:paddingBottom="26dp">

    <!-- Icon Badge -->
    <TextView
        android:id="@+id/tvConfirmIcon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:text="❓"
        android:textSize="26sp"
        android:layout_marginBottom="16dp" />

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirmation"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Dialog Message -->
    <TextView
        android:id="@+id/tvConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to proceed?"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="8dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_btn_secondary"
            app:backgroundTint="@null"
            android:text="CANCEL"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="23dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmOk"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_btn_primary"
            app:backgroundTint="@null"
            android:text="CONFIRM"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="23dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
