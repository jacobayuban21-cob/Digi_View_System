<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Icon + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAchIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:text="🎯"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvAchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Locked"
            android:textColor="@color/amber"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Title & Description -->
    <TextView
        android:id="@+id/tvAchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="First Quiz"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvAchDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Complete at least one quiz."
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <!-- Progress Count and Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvAchProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 1"
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/achProgressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progressDrawable="@drawable/bg_progress_pill"
        android:progress="0"
        android:layout_marginTop="6dp" />

</LinearLayout>
