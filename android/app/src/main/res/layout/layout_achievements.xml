<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= HERO ACHIEVEMENTS BANNER ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Achievements 🏆"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAchievementsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 of 9 unlocked — achievements are based on your quiz results."
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <!-- Overall Progress Bar -->
            <ProgressBar
                android:id="@+id/achievementsOverallBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressDrawable="@drawable/bg_progress_pill"
                android:progress="0"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Achievements Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALL BADGES &amp; MILESTONES"
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="14dp" />

        <!-- Dynamic Container for 9 Achievement Cards -->
        <LinearLayout
            android:id="@+id/achievementsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
