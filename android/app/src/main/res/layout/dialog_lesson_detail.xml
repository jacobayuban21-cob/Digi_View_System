<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header with Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLessonModalIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="🌐"
                android:textSize="22sp"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLessonModalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTML Basics"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Module Documentation"
                    android:textColor="@color/cyan"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Explanation Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPLANATION"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLessonModalExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HTML stands for HyperText Markup Language..."
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />

        <!-- Code Snippet Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAMPLE CODE"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_code_container"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLessonModalCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&lt;!DOCTYPE html&gt;&#10;&lt;html&gt;&#10;  &lt;body&gt;Hello&lt;/body&gt;&#10;&lt;/html&gt;"
                android:textColor="@color/cyan_glow"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLessonModalClose"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue"
            android:text="Close Module"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
