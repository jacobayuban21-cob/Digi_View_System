<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- ================= 1. LOGIN CARD (EXACT DESKTOP COPY) ================= -->
        <LinearLayout
            android:id="@+id/authLoginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="440dp"
            android:background="@drawable/bg_auth_card"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp"
            android:visibility="visible">

            <!-- Digi-View Brand Header (DV Logo + Text) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_launcher_dv"
                    android:contentDescription="DigiView Logo"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DigiView"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <!-- Sign In Heading -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGN IN"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  /  FILL OUT THE FORM"
                    android:textColor="@color/auth_hint"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <!-- Username Input -->
            <EditText
                android:id="@+id/etLoginUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Username"
                android:textColorHint="@color/auth_hint"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:inputType="textNoSuggestions" />

            <!-- Password Input -->
            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Password"
                android:textColorHint="@color/auth_hint"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:layout_marginTop="14dp"
                android:inputType="textPassword" />

            <!-- Cloud Server Connection Quick Bar (Hidden for production) -->
            <LinearLayout
                android:id="@+id/btnLoginServerPill"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:visibility="gone"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvLoginServerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️ Render Cloud (Connected)"
                    android:textColor="@color/cyan"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_auth_btn_primary"
                app:backgroundTint="@null"
                android:text="SIGN IN"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:cornerRadius="25dp"
                android:layout_marginTop="20dp" />

            <!-- Create Account Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_auth_btn_secondary"
                app:backgroundTint="@null"
                android:text="CREATE AN ACCOUNT"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="24dp"
                android:layout_marginTop="12dp" />

            <!-- Demo account helper button -->
            <TextView
                android:id="@+id/tvQuickDemoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Default login: student / admin123 (Tap to auto-fill)"
                android:textColor="@color/cyan"
                android:textSize="11.5sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Version Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V1.0.0"
                android:textColor="@color/auth_hint"
                android:textSize="11sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- ================= 2. SIGN UP CARD (EXACT DESKTOP COPY) ================= -->
        <LinearLayout
            android:id="@+id/authRegisterCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="440dp"
            android:background="@drawable/bg_auth_card"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="30dp"
            android:paddingBottom="26dp"
            android:visibility="gone">

            <!-- Digi-View Brand Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_launcher_dv"
                    android:contentDescription="DigiView Logo"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DigiView"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sign Up Heading -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGN UP"
                    android:textColor="@color/text_white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  /  STUDENT PROFILE DETAILS"
                    android:textColor="@color/auth_hint"
                    android:textSize="10.5sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <!-- Student Full Name -->
            <EditText
                android:id="@+id/etRegFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Student Name"
                android:textColorHint="@color/auth_hint"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:inputType="textPersonName" />

            <!-- Grade & Section Row (Just like desktop GridLayout(1, 2)) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/etRegGrade"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Grade (e.g. 11)"
                    android:textColorHint="@color/auth_hint"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/etRegSection"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Section"
                    android:textColorHint="@color/auth_hint"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Gender Selector Spinner -->
            <Spinner
                android:id="@+id/spRegGender"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_auth_input"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Password -->
            <EditText
                android:id="@+id/etRegPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Password (min 4 chars)"
                android:textColorHint="@color/auth_hint"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:layout_marginTop="12dp"
                android:inputType="textPassword" />

            <!-- Confirm Password -->
            <EditText
                android:id="@+id/etRegConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Confirm Password"
                android:textColorHint="@color/auth_hint"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:layout_marginTop="12dp"
                android:inputType="textPassword" />

            <!-- Create Account Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_auth_btn_primary"
                app:backgroundTint="@null"
                android:text="CREATE ACCOUNT"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:cornerRadius="25dp"
                android:layout_marginTop="18dp" />

            <!-- Back to Login Button -->
            <TextView
                android:id="@+id/btnGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALREADY REGISTERED? LOGIN"
                android:textColor="@color/cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
