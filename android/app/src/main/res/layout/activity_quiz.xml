<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <!-- Top Bar: Title & Exit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quizTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTML Basics Quiz"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quizProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question 1 of 10"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitQuiz"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Exit Quiz"
            android:textColor="#FCA5A5"
            app:strokeColor="#7F1D1D"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Question Card -->
    <LinearLayout
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvHearts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤ 5 Hearts"
            android:textColor="@color/red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <TextView
            android:id="@+id/tvQuestionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUESTION 01"
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What does HTML stand for?"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- Answer Options (A, B, C, D) -->
    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Option A -->
        <LinearLayout
            android:id="@+id/optA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_option_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="HyperText Markup Language"
                android:textColor="@color/text_white"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Option B -->
        <LinearLayout
            android:id="@+id/optB"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_option_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center"
                android:text="B"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="HighText Machine Language"
                android:textColor="@color/text_white"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Option C -->
        <LinearLayout
            android:id="@+id/optC"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_option_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center"
                android:text="C"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Hyperlink Text Language"
                android:textColor="@color/text_white"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Option D -->
        <LinearLayout
            android:id="@+id/optD"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_option_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center"
                android:text="D"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionD"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Home Tool Markup Language"
                android:textColor="@color/text_white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Feedback text -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose the best answer."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <!-- Action buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Submit Answer"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/blue"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Next Question →"
        android:textColor="@color/d_sidebar"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/cyan"
        android:visibility="gone"
        app:cornerRadius="16dp" />

</LinearLayout>
