# =======================================================
# DigiView Backend - Environment Variables Template
# Copy this file to .env and fill in your Supabase details
# NEVER commit the real .env file to Git!
# =======================================================

# 1. Supabase PostgreSQL Connection URL
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Example: jdbc:postgresql://db.abcdefghijklmnopqrst.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# 2. Database Username (usually 'postgres')
SUPABASE_DB_USER=postgres

# 3. Database Password (the password you created when creating your Supabase project)
SUPABASE_DB_PASSWORD=YOUR_ACTUAL_SUPABASE_PASSWORD

# 4. Server Port (default 8085)
PORT=8085
